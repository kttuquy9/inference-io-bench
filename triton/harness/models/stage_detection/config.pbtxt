# Stage 1 (detection giả lập): nhận frame float32, trả tensor "boxes" float32.
# Compute tối thiểu (reshape) — chi phí chủ yếu là ranh giới, giống production khi model nhẹ hơn copy.
backend: "python"
max_batch_size: 0
input [ { name: "FRAME" data_type: TYPE_FP32 dims: [ -1 ] } ]
output [ { name: "BOXES" data_type: TYPE_FP32 dims: [ -1 ] } ]
instance_group [ { count: 1 kind: KIND_GPU } ]
