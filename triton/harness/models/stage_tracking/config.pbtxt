# Stage 1 (tracking giả lập): nhận TRACKS, trả TRACKS.
# Compute tối thiểu (reshape) — chi phí chủ yếu là ranh giới, giống production khi model nhẹ hơn copy.
backend: "python"
max_batch_size: 0
input [ { name: "BOXES_IN" data_type: TYPE_FP32 dims: [ -1 ] } ]
output [ { name: "TRACKS" data_type: TYPE_FP32 dims: [ -1 ] } ]
instance_group [ { count: 1 kind: KIND_GPU } ]
