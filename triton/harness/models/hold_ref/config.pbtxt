# Rủi ro: model GIỮ mảng numpy của request trước sang request sau.
# Mỗi request kiểm lại tổng của mảng cũ. Vùng nhớ bị trả/tái dùng -> tổng đổi -> OUT = 1.
# Bắt buộc = 0 ở mọi request, trước và sau bản vá. Khác 0 = dữ liệu hỏng, bản vá chết.
backend: "python"
max_batch_size: 1024
input [ { name: "IN" data_type: TYPE_FP32 dims: [ -1 ] } ]
output [ { name: "OUT" data_type: TYPE_FP32 dims: [ 1 ] } ]
instance_group [ { count: 1 kind: KIND_CPU } ]
