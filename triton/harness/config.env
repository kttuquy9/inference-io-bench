# Cấu hình harness. Ghi lại để mọi số đo truy được về đúng môi trường.
# Đổi TRITON_TAG nếu driver không hợp; 24.08 cần driver >=535 (EC2 DLAMI có 535.161).
# Bản mới: TRITON_TAG=26.09-py3, SDK giữ 24.08 (cùng bộ bắn tải = cùng cái cân; giao thức HTTP/shm không đổi)
TRITON_TAG=${TRITON_TAG:-24.08-py3}
TRITON_SDK_TAG=${TRITON_SDK_TAG:-24.08-py3-sdk}        # chứa perf_analyzer
# Tham số thêm cho tritonserver. Bản mới (26.x) mặc định CHẶN client shared memory -> perf_analyzer --shared-memory
# báo "Client shared memory is disabled"; 24.08 không biết cờ này -> chỉ thêm khi chạy bản mới.
SRV_ARGS=${SRV_ARGS:-}
GPU=T4
# Tải
WARMUP_ITERS=50
MEASURE_RUNS=${MEASURE_RUNS:-10}                     # số lần lặp để lấy noise floor
CONCURRENCY="1 4 16"
BATCH_SIZES="1 4 16 64"                 # 64 x 6.2MB = 400MB/request, vừa shm
SOAK_MINUTES=${SOAK_MINUTES:-60}                     # tải dài để lộ leak/drift
# Kích thước tensor: mô phỏng frame video (1080p 3-kênh float32 ~ 6MB, và path BYTES cho OCR)
TENSOR_ELEMS_LARGE=1555200          # số phần tử float32 = 6.2MB = 1 frame 1080p RGB uint8
TENSOR_ELEMS_SMALL=2048              # 8KB
ASYM_RATIO=0.5                      # 50% request nhỏ / 50% lớn
# Quét cỡ tensor: crop nhỏ 64x64x3, ảnh 224x224x3, frame 1080p — số phần tử float32
SWEEP_ELEMS="12288 150528 1555200"
SWEEP_BATCH="1 16"
SWEEP_MODELS="identity_in identity_fp32"   # in = chỉ chiều vào; fp32 = vào + ra (hiệu = chiều ra)
# Nhiều instance: thêm CPU có gánh được không hay đụng trần băng thông RAM
INSTANCES="1 2 4"
# Tiền: giá máy đo theo giờ, ghi vào JSON field cost. Spot thay đổi -> ghi đúng giá lúc thuê.
USD_PER_HOUR=${USD_PER_HOUR:-0.526}   # g4dn.xlarge on-demand us-east-1
GPU_SAMPLE_MS=500
# Bản đồ chi phí (bash run.sh costmap): cỡ ảnh x batch x thời gian model, mỗi ô đo lặp COSTMAP_RUNS lần
COSTMAP_ELEMS="${COSTMAP_ELEMS:-150528 691200 1555200 6220800}"   # 224x224x3, 720p, 1080p, 4K (số phần tử float32)
COSTMAP_BATCH="${COSTMAP_BATCH:-1 4 16}"                          # 4K bỏ batch 16 (400 MB/request)
COSTMAP_WORK="${COSTMAP_WORK:-0 2 10 30}"                        # ms model tốn mỗi lần execute (danh nghĩa)
COSTMAP_SPIN="${COSTMAP_SPIN:-0:0 2:1 10:5 30:15}"               # ms danh nghĩa -> số MatMul của cm_spin_d<N>; thời gian thật đo hiệu chuẩn
COSTMAP_RUNS=${COSTMAP_RUNS:-3}
# Kiểu dữ liệu kiểm ở bài integrity (dt_check_<kiểu>), theo tên kiểu của Triton
DTYPES="${DTYPES:-FP16 FP32 FP64 INT8 UINT8 INT16 INT32 INT64 BOOL}"
# Bài cầm nhiều mảng (bash run.sh hold): số mảng model cầm, số request mỗi lần chạy tải
HOLD_COUNTS="${HOLD_COUNTS:-10 100}"
HOLD_REQS=${HOLD_REQS:-3000}                   # nvidia-smi lấy mẫu GPU trong lúc đo
