+#ifdef TRITON_PB_STUB
+void
+PbTensor::PinNumpyToSharedMemory(
+    std::unique_ptr<SharedMemoryManager>& shm_pool,
+    bi::managed_external_buffer::handle_t data_handle)
+{
+  if ((memory_type_ != TRITONSERVER_MEMORY_CPU &&
+       memory_type_ != TRITONSERVER_MEMORY_CPU_PINNED) ||
+      dtype_ == TRITONSERVER_TYPE_BF16 || dtype_ == TRITONSERVER_TYPE_BYTES) {
+    return;
+  }
+  // Wrap the shared memory buffer without copying. The tensor object can be
+  // destroyed while the NumPy array is still in use (e.g. the model keeps the
+  // array across requests), so the array owns its own reference to the shared
+  // memory block. The block is not reused until the array is released.
+  auto* block =
+      new AllocatedSharedMemory<char>(shm_pool->Load<char>(data_handle));
+  py::capsule owner(block, [](void* ptr) {
+    delete reinterpret_cast<AllocatedSharedMemory<char>*>(ptr);
+  });
+  py::object numpy_array = py::array(
+      triton_to_pybind_dtype(dtype_), dims_, (void*)memory_ptr_, owner);
+  numpy_array_ = numpy_array.attr("view")(triton_to_numpy_type(dtype_));
+}
+#endif  // TRITON_PB_STUB
