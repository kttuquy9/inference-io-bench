+namespace {
+// Zero-copy CPU inputs are opt-in. With the flag off the behavior is unchanged:
+// every CPU input is copied into a new NumPy array. With the flag on, in-place
+// writes to an input array write to the shared memory buffer of that input.
+bool
+ZeroCopyInputsEnabled()
+{
+  static const bool enabled = [] {
+    const char* value = std::getenv("TRITON_PYTHON_BACKEND_ZERO_COPY_INPUTS");
+    if (value == nullptr) {
+      return false;
+    }
+    std::string v(value);
+    return v == "1" || v == "true" || v == "TRUE" || v == "True";
+  }();
+  return enabled;
+}
+}  // namespace
+#endif  // TRITON_PB_STUB
