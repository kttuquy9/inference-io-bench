+uint64_t
+ZcSum(const void* p, uint64_t n)
+{
+  const unsigned char* b = static_cast<const unsigned char*>(p);
+  uint64_t s = 0;
+  for (uint64_t i = 0; i < n && i < 4096; i++) {
+    s = s * 131 + b[i];
+  }
+  return s;
+}
+double
+ZcNowMs()
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_REALTIME, &ts);
+  return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+struct ZcPinned {
+  AllocatedSharedMemory<char> block;
+  double t_pin;
+  std::string name;
+};
+uint32_t
+ZcRef(void* data)
+{
+  return reinterpret_cast<AllocatedShmOwnership*>(
+             reinterpret_cast<char*>(data) - sizeof(AllocatedShmOwnership))
+      ->ref_count_;
+}
+}  // namespace
+#endif  // TRITON_PB_STUB
